<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Card">
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">18dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>
    <style name="Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Muted" parent="Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="Field">
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
</resources>
