<?xml version="1.0" encoding="utf-8"?>
<!-- The sign-in secret never leaves this phone: no cloud backup, no copy to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
